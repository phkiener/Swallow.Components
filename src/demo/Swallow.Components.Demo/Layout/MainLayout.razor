@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@inherits LayoutComponentBase

<HeadContent>
    <SwallowComponentsSetup />
</HeadContent>

<div id="app">
    <header>
        <h1>Swallow Components</h1>
    </header>

    <aside>
        <nav>
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>

            <span>Actions</span>
            <NavLink href="/actions/button">Button</NavLink>
            <NavLink href="/actions/link-button">Link Button</NavLink>
            <NavLink href="/actions/icon-button">Icon Button</NavLink>
            <NavLink href="/actions/button-group">Button Group</NavLink>

            <span>Display</span>
            <NavLink href="/display/alert">Alert</NavLink>
            <NavLink href="/display/badge">Badge</NavLink>

            <span>Inputs</span>
            <NavLink href="/inputs/text">Text Input</NavLink>

            <span>Layout</span>
            <NavLink href="/layout/tabs">Tabs</NavLink>
        </nav>
    </aside>

    <main>
        <article>
            <CascadingValue Value="@this" IsFixed>
                @Body
            </CascadingValue>
        </article>

        <aside>
            <span>On this page:</span>
            @foreach (var subHeading in sections)
            {
                <a href="@navigationManager.Uri#@(subHeading.Anchor)">@subHeading.Title</a>
            }
        </aside>
    </main>
</div>
