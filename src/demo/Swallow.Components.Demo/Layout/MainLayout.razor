@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@inherits LayoutComponentBase

<HeadContent>
    <SwallowComponentsSetup />
</HeadContent>

<div id="app">
    <header>
        <h1>Swallow Components</h1>
    </header>

    <aside>
        <nav>
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="/actions/button">Button</NavLink>
            <NavLink href="/actions/link-button">Link Button</NavLink>
            <NavLink href="/actions/icon-button">Icon Button</NavLink>
            <NavLink href="/actions/button-group">Button Group</NavLink>
        </nav>
    </aside>

    <main>
        <article>
            @Body
        </article>
    </main>
</div>
