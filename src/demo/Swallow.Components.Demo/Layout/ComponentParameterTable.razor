@using Swallow.Components.Demo.Utils
@using Swallow.Components.Typography
@typeparam TComponent

<table class="sw-table">
    <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Description</th>
        <th>Default Value</th>
    </tr>

    @foreach (var parameter in parameters)
    {
        <tr>
            <td>@parameter.Name @(parameter.Required ? "*" : "")</td>
            <td><SwCode>@parameter.Type.PrettyName(parameter.IsNullable)</SwCode></td>
            <td><InlineDocumentation Type="@typeof(TComponent)" Property="@parameter.Name" /> </td>
            <td><SwCode>@parameter.DefaultValue</SwCode></td>
        </tr>
    }
</table>
