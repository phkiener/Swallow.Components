@*
    TODO for reactive rendering:

    I need two different kinds of interactivity - persistent server with JS interop and "slim".
    For JS interop, we can keep the code as-is, all good.
    For static rendering, we don't need to change anything either; the callbacks are never invoked because.. well.. it's static.
    For my plan for reactive rendering, I do need to change the code. Because the JS runtime will *not* be there, hence I need the
    code to register the client-side script like for static rendering.
    But OnShow, OnHide and SelectedChanged should be invoked, so I'd need a different event to be executed here. OnActivated and OnDecativated come to
    mind, but they're not really meant for this case... maybe load works?
*@

<div class="sw-tabs" data-registered="@RendererInfo.IsInteractive">
    <div class="tab-list" role="tablist" @onkeydown="@OnTabListInput">
        @foreach (var tab in registeredTabs)
        {
            <button type="button"
                    class="sw text"
                    id="@tab.TabId"
                    role="tab"
                    tabindex="@(tab.Selected ? "0" : "-1")"
                    aria-selected="@(tab.Selected ? "true" : "false")"
                    aria-controls="@tab.PanelId"
                    @onclick="@(() => OnTabClicked(tab))"
                    @key="tab.TabId">
                @tab.Title
            </button>
        }
    </div>

    <div class="tab-panels">
        @foreach (var tab in registeredTabs)
        {
            <div id="@tab.PanelId"
                 role="tabpanel"
                 tabindex="0"
                 hidden="@(!tab.Selected)"
                 aria-labelledby="@tab.TabId"
                 @key="tab.PanelId">
                @tab.Content
            </div>
        }
    </div>

    <CascadingValue Value="@this" IsFixed>
        @ChildContent
    </CascadingValue>
</div>
